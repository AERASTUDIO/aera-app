rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aðeins AERA Studio aðgangurinn má lesa og skrifa. Allir aðrir fá synjun.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "aerastudioice@gmail.com";
    }
  }
}
